# Server runtime
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
SENTINEL_INFRASTRUCTURE_MODE=local
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/sentinel.db
RUN_EMBEDDED_EVALUATOR=true

# AWS / DynamoDB / Bedrock credentials are supplied by the runtime environment.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Authentication and service secrets
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
WS_TICKET_SECRET=
ENGINE_API_SECRET=

# Optional browser/API configuration
CORS_ORIGINS=http://localhost:8081
