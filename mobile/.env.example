# Clerk Authentication
# Obtain from https://dashboard.clerk.com/ -> API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# API and realtime endpoints. Production builds must use HTTPS/WSS.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_WS_URL=wss://api.example.com
# Optional EAS project id used to mint Expo push tokens in development builds.
EXPO_PUBLIC_EAS_PROJECT_ID=
