        "WMA",
        "WEMA",
        "RSI",
        "MACD",
        "BOLLINGER_BANDS",
        "BOLLINGER",
        "KELTNER_CHANNELS",
        "STOCHASTIC",
        "STOCHASTIC_RSI",
        "CCI",
        "ATR",
        "ADX",
        "ROC",
        "AWESOME_OSCILLATOR",
        "TRIX",
        "WILLIAMS_R",
        "VOLUME",
        "OBV",
        "MFI",
        "VWAP",
        "PSAR",
        "ICHIMOKU_CLOUD",
        "PRICE"
      ]
