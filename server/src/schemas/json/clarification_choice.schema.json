{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "input": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "TEXT"
        },
        "placeholder": {
          "type": "string",
          "maxLength": 300
        },
        "submit_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "label"
  ],
  "additionalProperties": false
}