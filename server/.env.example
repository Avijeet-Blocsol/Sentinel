# Runtime
NODE_ENV=production

# Clerk Backend Authentication
# Obtain from https://dashboard.clerk.com/ -> API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Production infrastructure. The API process does not own scheduling;
# EventBridge Scheduler delivers to the SQS worker.
SENTINEL_INFRASTRUCTURE_MODE=aws
DATABASE_PROVIDER=dynamodb
RUN_EMBEDDED_EVALUATOR=false
DATABASE_PATH=

# Production model provider
AWS_REGION=us-east-1
SENTINEL_MODEL_PROVIDER=bedrock

# AWS infrastructure
AWS_S3_SESSION_BUCKET=
AWS_S3_SESSION_PREFIX=sentinel/sessions/
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_S3_KMS_KEY_ID=
DYNAMODB_TABLE_PREFIX=sentinel_
DYNAMODB_TABLE_EXECUTIONS=sentinel_execution_leases
# Name of the GSI used by the scheduler hot path; provision it before enabling
# the DynamoDB adapter, then run `npm run backfill:due-schedule` once.
DYNAMODB_DUE_SCHEDULE_INDEX_NAME=idx_due_schedule
ENGINE_API_SECRET=
WS_TICKET_SECRET=
SENTINEL_EXECUTION_QUEUE_URL=
SENTINEL_EXECUTION_DLQ_URL=
SENTINEL_SQS_CONCURRENCY=5
SENTINEL_SQS_VISIBILITY_TIMEOUT_SECONDS=300
SENTINEL_SQS_MAX_RECEIVE_COUNT=8
SENTINEL_SCHEDULER_TARGET_ARN=
SENTINEL_SCHEDULER_TARGET_TYPE=sqs
SENTINEL_SCHEDULER_ROLE_ARN=
# Scheduler delivery DLQ: must be a standard SQS queue.
SENTINEL_SCHEDULER_DLQ_ARN=
SENTINEL_SCHEDULER_NAME=sentinel-global-tick
SENTINEL_SCHEDULER_EXPRESSION=rate(1 minute)
SENTINEL_SCHEDULER_MAX_RETRY_ATTEMPTS=3
SENTINEL_SCHEDULER_MAX_EVENT_AGE_SECONDS=3600
# Required only for a FIFO target; the target queue must enable content-based deduplication.
SENTINEL_SQS_MESSAGE_GROUP_ID=
SENTINEL_EXECUTION_LEASE_MS=300000
AGENTIC_EVALUATOR_ENABLE_TOOLS=false
AGENTIC_MIN_CONFIDENCE=0.70
CORS_ORIGINS=
SENTINEL_PUSH_NOTIFICATIONS_ENABLED=false
