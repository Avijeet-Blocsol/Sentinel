{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "natural_language_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "category": {
      "default": "FINANCIAL",
      "type": "string",
      "enum": [
        "FINANCIAL",
        "CRYPTO",
        "PREDICTION_MARKET",
        "WEB_INTEL",
        "SOCIAL_STREAM",
        "ECOMMERCE"
      ]
    },
    "combinator": {
      "type": "string",
      "enum": [
        "AND",
        "OR",
        "SINGLE"
      ]
    },
    "condition_tree": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32000
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger_mode": {
      "type": "string",
      "enum": [
        "ONE_SHOT",
        "PERSISTENT"
      ]
    },
    "cooldown_minutes": {
      "default": 60,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "audio_tone": {
      "type": "string",
      "enum": [
        "cash_register",
        "siren",
        "chime"
      ]
    },
    "status": {
      "default": "ACTIVE",
      "type": "string",
      "enum": [
        "ACTIVE",
        "TRIGGERED",
        "DISMISSED",
        "PAUSED",
        "ARCHIVED"
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "last_triggered_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "action_template": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 16000
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "user_id",
    "title",
    "natural_language_intent",
    "category",
    "combinator",
    "trigger_mode",
    "cooldown_minutes",
    "audio_tone",
    "status",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}